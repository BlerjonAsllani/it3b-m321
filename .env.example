# Vorlage fuer die Datei .env. Kopieren und bei Bedarf anpassen:
#   cp .env.example .env && docker compose up -d --build
# Die Datei .env selbst gehoert NICHT ins Repository (siehe .gitignore).

# --- Datenbank ---
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat

# --- Topics ---
# Topic, auf das der chat-service schreibt und von dem der batch-writer liest.
CHAT_TOPIC=chat.persist
# Topic fuer Nachrichten, die sich nie speichern lassen.
DLQ_TOPIC=chat.dlq

# --- Verhalten des batch-writer ---
# Hoechstens so viele Nachrichten schreibt er mit einem einzigen INSERT.
BATCH_SIZE=500
# So lange wartet der Broker hoechstens auf genuegend Daten, bevor er ein Paket liefert.
BATCH_WAIT_MS=200
# Pause zwischen zwei Versuchen, wenn die Datenbank nicht erreichbar ist.
RETRY_INTERVAL_MS=5000
# Consumer-Gruppe. Alle Instanzen teilen sie sich, damit jede Partition genau eine Instanz hat.
BATCH_GROUP_ID=batch-writer
